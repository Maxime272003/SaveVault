{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SaveVault",
  "version": "../package.json",
  "identifier": "com.maxime272003.savevault",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "SaveVault",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 640,
        "backgroundColor": "#0E1014"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Gestionnaire de saves de jeux vidéo",
    "copyright": "© 2026 Maxime272003 — MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5MDIzRDdBMEM2MjE1RDYKUldUV0ZXSU1lajBDT1cxeXI5aXNic1FrRUhuUDNaa25UMTUzOFpZeENpSGVOMElxMktzZnRPMVcK",
      "endpoints": [
        "https://github.com/Maxime272003/SaveVault/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
